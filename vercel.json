{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/home.html",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "uniifyforartists.com"
        }
      ],
      "destination": "https://www.uniifyforartists.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/auth-callback.html",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
